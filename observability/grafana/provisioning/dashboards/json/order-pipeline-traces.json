{
  "uid": "veta-order-pipeline-traces",
  "title": "Order Pipeline (Traces)",
  "description": "Trace-driven view of the order lifecycle. The platform's HTTP and Kafka hops both propagate trace context, so a single submitted order produces one connected trace from Gateway through OMS, Risk, Algo, EMS, and Journal. This dashboard surfaces the slowest, the failed, and the most active. **Empty panels** mean no recent order activity — submit an order via the Trading UI or run Demo Day from Mission Control to populate the view.",
  "tags": ["veta", "otel", "orders", "traces"],
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,

  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "End-to-end performance",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Order pipeline latency (OMS span p50/p95/p99)",
      "description": "Latency of OMS's per-order processing span — the time from receiving orders.new to publishing orders.submitted (after risk-check). Order submission via WebSocket isn't a regular HTTP span, so the OMS-side measurement is the closest proxy for end-user wait time.",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 },
          "noValue": "no order activity in this window"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"oms\",span_kind=\"SPAN_KIND_CLIENT\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"oms\",span_kind=\"SPAN_KIND_CLIENT\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"oms\",span_kind=\"SPAN_KIND_CLIENT\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Per-stage latency (p95)",
      "description": "p95 latency for each pipeline service. Stages with rising lines are bottlenecks.",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 9 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 }
        }
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{service=~\"gateway|oms|risk-engine|ems|journal|limit-algo|twap-algo|pov-algo|vwap-algo\",url_path!~\"/health|/healthz|/api/overview|/logs/query|/data-depth\"}[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        }
      ]
    },

    {
      "id": 2,
      "type": "row",
      "title": "Order flow (per-stage throughput)",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Submitted",
      "description": "Orders entering the pipeline (orders.submitted topic).",
      "gridPos": { "x": 0, "y": 11, "w": 4, "h": 5 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "—"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"kafka-relay\"} | json | type = `orders.submitted` [$__interval]))",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Routed",
      "description": "Orders that passed risk and were routed to an algo (orders.routed).",
      "gridPos": { "x": 4, "y": 11, "w": 4, "h": 5 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "—"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"kafka-relay\"} | json | type = `orders.routed` [$__interval]))",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Child slices",
      "description": "Algo-generated child orders (orders.child). Volume is typically multiples of routed.",
      "gridPos": { "x": 8, "y": 11, "w": 4, "h": 5 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "noValue": "—"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"kafka-relay\"} | json | type = `orders.child` [$__interval]))",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Filled",
      "description": "Child orders executed (orders.filled).",
      "gridPos": { "x": 12, "y": 11, "w": 4, "h": 5 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "noValue": "—"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"kafka-relay\"} | json | type = `orders.filled` [$__interval]))",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Rejected",
      "description": "Orders rejected at risk-engine or OMS limit checks (orders.rejected).",
      "gridPos": { "x": 16, "y": 11, "w": 4, "h": 5 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "noValue": "—"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"kafka-relay\"} | json | type = `orders.rejected` [$__interval]))",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Expired",
      "description": "Orders expired before fill (orders.expired).",
      "gridPos": { "x": 20, "y": 11, "w": 4, "h": 5 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "noValue": "—"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"kafka-relay\"} | json | type = `orders.expired` [$__interval]))",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },
    {
      "id": 27,
      "type": "text",
      "title": "Pipeline architecture",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 7 },
      "options": {
        "mode": "markdown",
        "content": "```\n  ┌────────┐  orders.submitted  ┌──────────────┐  orders.routed  ┌──────┐  orders.child  ┌─────┐  orders.filled  ┌─────────┐\n  │ User / │ ─────────────────▶ │ Risk-engine  │ ──────────────▶ │ Algo │ ────────────▶ │ EMS │ ──────────────▶ │ Journal │\n  │ Gateway│                    │ check + OMS  │                 │      │                │     │                  │ (DB)    │\n  └────────┘                    └──────────────┘                 └──────┘                └─────┘                  └─────────┘\n                                       │                                                       │\n                                       ▼                                                       ▼\n                                orders.rejected                                          orders.expired\n```\n\n**How to read the row above:** each stat shows the per-second event rate for that pipeline stage, averaged across the dashboard time window. Healthy steady-state: **routed ≈ submitted minus rejected**, **child > routed** (algo expansion), **filled ≈ child** (with small expired tail). Empty values mean no orders are flowing — submit an order via the trading UI or run **Demo Day** from Mission Control."
      }
    },

    {
      "id": 3,
      "type": "row",
      "title": "Errors and slow traces",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 30,
      "type": "table",
      "title": "Recent error spans",
      "description": "Spans with status=ERROR in the selected window. Click TraceID to open the full trace.",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 10 },
      "datasource": { "uid": "tempo", "type": "tempo" },
      "options": { "showHeader": true },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "filters": [
            { "id": "service-name", "operator": "=", "scope": "span", "tag": "status", "value": ["error"] }
          ],
          "limit": 50,
          "refId": "A",
          "datasource": { "uid": "tempo", "type": "tempo" }
        }
      ]
    },
    {
      "id": 31,
      "type": "table",
      "title": "Slowest traces (>500ms)",
      "description": "Traces that took longer than 500ms end-to-end. The order pipeline target is sub-100ms.",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 10 },
      "datasource": { "uid": "tempo", "type": "tempo" },
      "options": { "showHeader": true },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ trace:duration > 500ms }",
          "limit": 50,
          "refId": "A",
          "datasource": { "uid": "tempo", "type": "tempo" }
        }
      ]
    },

    {
      "id": 4,
      "type": "row",
      "title": "Bus events",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Order events from bus",
      "description": "Order lifecycle events as observed by kafka-relay → Loki. Use this when traces are too detailed.",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 9 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineInterpolation": "stepAfter", "fillOpacity": 60 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (type) (count_over_time({service_name=\"kafka-relay\"} | json | type =~ \"orders\\\\.(submitted|filled|rejected|expired|cancelled)\" [30s]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    },

    {
      "id": 5,
      "type": "row",
      "title": "Order-flow Sankey",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 50,
      "type": "barchart",
      "title": "Order flow — stage transitions (count over window)",
      "description": "Counts each lifecycle transition over the dashboard time range, showing where order volume goes at each branch in the pipeline. Sourced from kafka-relay → Loki. Built-in Sankey requires Grafana ≥11.5; this stack runs 11.4.0, so the same five transitions are rendered as a bar chart instead — each bar is one edge of the Sankey and its height is the edge weight (event count).\n\nTransitions:\n  submitted → routed   (accepted by risk, handed to algo)\n  submitted → rejected (rejected at risk)\n  routed    → child    (algo sliced parent into child orders)\n  child     → filled   (executed by EMS)\n  child     → expired  (timed out before fill)",
      "gridPos": { "x": 0, "y": 45, "w": 24, "h": 10 },
      "datasource": { "uid": "loki", "type": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 80, "axisPlacement": "auto" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"kafka-relay\"} | json | type = \"orders.routed\" [$__range]))",
          "legendFormat": "submitted → routed",
          "refId": "A",
          "datasource": { "uid": "loki", "type": "loki" }
        },
        {
          "expr": "sum(count_over_time({service_name=\"kafka-relay\"} | json | type = \"orders.rejected\" [$__range]))",
          "legendFormat": "submitted → rejected",
          "refId": "B",
          "datasource": { "uid": "loki", "type": "loki" }
        },
        {
          "expr": "sum(count_over_time({service_name=\"kafka-relay\"} | json | type = \"orders.child\" [$__range]))",
          "legendFormat": "routed → child",
          "refId": "C",
          "datasource": { "uid": "loki", "type": "loki" }
        },
        {
          "expr": "sum(count_over_time({service_name=\"kafka-relay\"} | json | type = \"orders.filled\" [$__range]))",
          "legendFormat": "child → filled",
          "refId": "D",
          "datasource": { "uid": "loki", "type": "loki" }
        },
        {
          "expr": "sum(count_over_time({service_name=\"kafka-relay\"} | json | type = \"orders.expired\" [$__range]))",
          "legendFormat": "child → expired",
          "refId": "E",
          "datasource": { "uid": "loki", "type": "loki" }
        }
      ]
    }
  ]
}
