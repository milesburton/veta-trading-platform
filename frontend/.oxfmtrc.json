{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "sortImports": { "newlinesBetween": false },
  "ignorePatterns": ["dist", "dist-app", "dist-electron", "coverage", "test-results", "public", "package-lock.json"]
}
