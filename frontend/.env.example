# frontend/.env.local overrides for local dev (this file is the template).
#
# The production bundle does NOT need any of these — servicesApi.ts falls
# back to same-origin `${window.location.origin}/api/<service>` paths,
# which the gateway routes to the right backend.
#
# Set these only if you're developing the frontend against locally-run
# backend services bound directly to host ports (not behind the gateway).
# Copy this file to frontend/.env.local and edit; .env.local is gitignored.

# VITE_MARKET_WS_URL=ws://localhost:5000
# VITE_MARKET_HTTP_URL=http://localhost:5000
# VITE_EMS_URL=http://localhost:5001
# VITE_OMS_URL=http://localhost:5002
# VITE_LIMIT_URL=http://localhost:5003
# VITE_TWAP_URL=http://localhost:5004
# VITE_POV_URL=http://localhost:5005
# VITE_VWAP_URL=http://localhost:5006

# Optional: explicit Traefik dashboard URL for the services panel.
# Leave unset in production — the fallback `${_origin}:8888` is removed
# in this PR so the services panel hides the dashboard link.
# VITE_TRAEFIK_DASHBOARD_URL=http://localhost:8888
