{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "ignorePatterns": [
    "../backend/**",
    "../shared/**",
    "../observability/**",
    "../homelab/**",
    "../edge/**",
    "../docs/**",
    "../packages/**",
    "../scripts/**",
    "../.husky/**",
    "../.github/**"
  ],
  "ignoreDependencies": [
    "@veta/auth",
    "@veta/http",
    "@veta/logger",
    "@veta/messaging",
    "@veta/rate-limit",
    "jsr:@std"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn",
    "unlisted-dependencies": "warn",
    "unused-files": "warn"
  }
}
