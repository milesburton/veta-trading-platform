{
  "name": "veta-trading-platform",
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "deno run -A npm:@biomejs/biome check src/",
    "lint:fix": "deno run -A npm:@biomejs/biome check --write src/",
    "lint:full": "npm run lint && npm run test:coverage",
    "typecheck": "tsc --noEmit",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:ui": "npx playwright test",
    "test:ui:headed": "npx playwright test --headed",
    "electron:dev": "node_modules/.bin/tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json',JSON.stringify({type:'commonjs'}))\" && node -e \"require('fs').cpSync('electron/assets','dist-electron/assets',{recursive:true})\" && node scripts/electron-dev.mjs",
    "electron:build": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json',JSON.stringify({type:'commonjs'}))\" && node -e \"require('fs').cpSync('electron/assets','dist-electron/assets',{recursive:true})\" && vite build --mode electron && electron-builder --dir",
    "electron:build-test": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json',JSON.stringify({type:'commonjs'}))\" && node -e \"require('fs').cpSync('electron/assets','dist-electron/assets',{recursive:true})\" && vite build --mode electron-test && electron-builder --dir",
    "electron:dist": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json',JSON.stringify({type:'commonjs'}))\" && node -e \"require('fs').cpSync('electron/assets','dist-electron/assets',{recursive:true})\" && vite build --mode electron && electron-builder",
    "test:electron": "npx playwright test --config=playwright.electron.config.ts",
    "prepare": "node -e \"if (!process.env.CI) { require('child_process').execSync('node frontend/node_modules/.bin/husky', {stdio:'inherit', cwd:'..'}) }\""
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "deno run -A npm:@biomejs/biome check --write",
      "bash -c './node_modules/.bin/tsc --noEmit --skipLibCheck --project tsconfig.json'"
    ]
  },
  "build": {
    "appId": "com.veta.trading-platform",
    "productName": "VETA Trading Platform",
    "publish": null,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "protocols": [
      {
        "name": "VETA Trading Platform",
        "schemes": [
          "veta"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Finance"
    }
  },
  "dependencies": {
    "@preact/signals-react": "^3.9.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@rrweb/types": "^2.0.0-alpha.20",
    "flexlayout-react": "^0.8.18",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.2.4",
    "react-redux": "^9.2.0",
    "react-window": "^2.2.7",
    "recharts": "^2.12.7",
    "rrweb": "^2.0.0-alpha.4",
    "rrweb-player": "^1.0.0-alpha.4",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.58.2",
    "@preact/signals-react-transform": "^0.8.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "fallow": "^2.75.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.2.10",
    "msw": "^2.12.14",
    "playwright": "^1.40.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^7.3.2",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.8",
    "ws": "^8.20.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
