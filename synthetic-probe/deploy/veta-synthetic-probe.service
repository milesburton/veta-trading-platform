[Unit]
Description=VETA synthetic probe (one-shot)
Documentation=https://github.com/milesburton/veta-trading-platform/blob/main/synthetic-probe/README.md
Wants=network-online.target
After=network-online.target
OnFailure=veta-synthetic-probe-alert@failure.service

[Service]
Type=oneshot
User=veta-probe
WorkingDirectory=/opt/veta-probe
EnvironmentFile=-/etc/veta-probe.env
Environment=PROBE_BASE_URL=https://veta.mnetcs.com
Environment=PROBE_TIMEOUT_MS=10000
ExecStart=/usr/local/bin/deno run --allow-net --allow-env /opt/veta-probe/probe.ts
# On success, clear any consecutive-failure counter and emit a recovery alert if needed.
ExecStartPost=/opt/veta-probe/alert.sh recovery
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30s
