# Non-secret deployment configuration. Copy to .env on the host if you need to override a default.
# For local dev (devcontainer) the defaults in compose.yml are sufficient.
#
# Secrets do not belong in this file. Production credentials (Postgres password, OAuth2 shared
# secret, Anthropic API key, GitHub ticketing token and the rest) live in OpenBao at
# secret/veta/platform and are injected by scripts/veta-compose.sh. See
# docs/site/src/content/docs/platform/supporting/openbao.md.
#
# NOTE: named "env.example" (no dot prefix) intentionally - dotenv tooling
# can treat ".env.example" as a required-vars manifest and fail startup
# for any service that doesn't have all listed vars present.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=veta
POSTGRES_DB=veta
POSTGRES_BACKUP_HOUR_UTC=03
POSTGRES_BACKUP_RETENTION_DAYS=14

# ── Git / build metadata ──────────────────────────────────────────────────────
COMMIT_SHA=dev

# ── LLM advisory ──────────────────────────────────────────────────────────────
# Provider for the llm-advisory subsystem: mock (default), ollama, or anthropic.
# LLM_PROVIDER=anthropic
# LLM_MODEL_ID=

# ── GitHub user-ticket integration ───────────────────────────────────────────
GITHUB_TICKETING_REPO=milesburton/veta-trading-platform

# ── Domain (self-hosted) ──────────────────────────────────────────────────────
# Used by Traefik for TLS cert provisioning and routing.
# DOMAIN=trading.example.com
# ACME_EMAIL=you@example.com
