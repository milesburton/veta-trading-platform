{
  "name": "veta-trading-platform",
  "version": "1.88.14",
  "private": true,
  "description": "VETA Trading Platform, real-time market simulation with algorithmic trading strategies.",
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .husky",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "lint": "npm run lint:backend && cd frontend && npm run lint",
    "lint:fix": "vp lint -c .oxlintrc.json --fix backend shared scripts synthetic-probe frontend-server.ts && cd frontend && npm run lint:fix",
    "format": "vp fmt -c .oxfmtrc.json backend shared scripts synthetic-probe frontend-server.ts",
    "typecheck": "npm run check && cd frontend && npm run typecheck",
    "test": "npm run test:backend && cd frontend && npm run test:unit -- --run",
    "test:backend": "vp test run",
    "test:frontend": "cd frontend && npm run test:unit -- --run",
    "test:integration": "vp test run --config vitest.integration.config.ts",
    "test:e2e": "cd frontend && npm run build && npm run test:ui",
    "fallow:backend:audit": "cd backend && ../frontend/node_modules/.bin/fallow audit",
    "fallow:backend:health": "cd backend && ../frontend/node_modules/.bin/fallow health --score --hotspots",
    "fallow:backend:dead-code": "cd backend && ../frontend/node_modules/.bin/fallow dead-code",
    "fallow:frontend:audit": "cd frontend && npx fallow audit",
    "fallow:frontend:health": "cd frontend && npx fallow health --score --hotspots",
    "fallow:frontend:dead-code": "cd frontend && npx fallow dead-code",
    "fallow:audit": "npm run fallow:backend:audit && npm run fallow:frontend:audit",
    "fallow:health": "npm run fallow:backend:health && npm run fallow:frontend:health",
    "fallow:dead-code": "npm run fallow:backend:dead-code && npm run fallow:frontend:dead-code",
    "quality:git": "git diff --check && git diff --cached --check && ! git status --short --untracked-files=normal | grep -q .",
    "check": "tsc --noEmit -p .",
    "test:coverage": "vp test run --coverage",
    "test:load": "vp test run --config vitest.integration.config.ts backend/src/tests/load.test.ts",
    "test:testcontainers": "./scripts/run-testcontainers.sh vp test run --config vitest.testcontainers.config.ts",
    "test:testcontainers:coverage": "rm -rf coverage-tc && COVERAGE_DIR=\"$PWD/coverage-tc\" ./scripts/run-testcontainers.sh vp test run --config vitest.testcontainers.config.ts && ./scripts/testcontainers-coverage-report.sh coverage-tc coverage-tc.lcov",
    "db:check-migrations": "node backend/db/checkMigrationsSafe.ts",
    "product-service": "node --env-file-if-exists=.env backend/src/product-service/product-service.ts",
    "lint:backend": "vp lint -c .oxlintrc.json backend shared scripts synthetic-probe frontend-server.ts",
    "format:check": "vp fmt -c .oxfmtrc.json --check backend shared scripts synthetic-probe frontend-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "kafkajs": "2.2.4",
    "pg": "^8.23.1",
    "ws": "^8.18.0",
    "zod": "4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "imports": {
    "#veta/primitives": "./shared/primitives.ts",
    "#veta/trader-archetypes": "./shared/traderArchetypes.ts",
    "#veta/http": "./backend/src/lib/http.ts",
    "#veta/auth": "./backend/src/lib/auth.ts",
    "#veta/db": "./backend/src/lib/db.ts",
    "#veta/logger": "./backend/src/lib/logger.ts",
    "#veta/messaging": "./backend/src/lib/messaging.ts",
    "#veta/telemetry": "./backend/src/lib/telemetry.ts",
    "#veta/bootstrap": "./backend/src/lib/bootstrap.ts",
    "#veta/market-client": "./backend/src/lib/market-sim-client.ts",
    "#veta/market-hours": "./backend/src/market-sim/market-hours.ts",
    "#veta/trading-calendar": "./backend/src/lib/trading-calendar.ts",
    "#veta/market-calendars": "./backend/src/lib/market-calendars.ts",
    "#veta/grid-query": "./backend/src/lib/grid-query.ts",
    "#veta/settlement": "./backend/src/lib/settlement.ts",
    "#veta/time-scale": "./backend/src/lib/time-scale.ts",
    "#veta/rate-limit": "./backend/src/lib/rate-limit.ts",
    "#veta/wait-for": "./backend/src/lib/wait-for.ts",
    "#veta/schemas": "./backend/src/schemas/index.ts",
    "#veta/schemas/primitives": "./backend/src/schemas/primitives.ts",
    "#veta/schemas/orders": "./backend/src/schemas/orders.ts",
    "#veta/schemas/risk": "./backend/src/schemas/risk.ts",
    "#veta/schemas/user": "./backend/src/schemas/user.ts",
    "#veta/schemas/news": "./backend/src/schemas/news.ts",
    "#veta/types/orders": "./backend/src/types/orders.ts",
    "#veta/types/trade": "./backend/src/types/types.ts",
    "#veta/types/intelligence": "./backend/src/types/intelligence.ts",
    "#veta/types/llm-advisory": "./backend/src/types/llm-advisory.ts",
    "#veta/types/grid-query": "./backend/src/types/grid-query.ts",
    "#veta/test-assert": "./backend/src/test-support/assert.ts",
    "#veta/run-node": "./backend/src/test-support/run-node.ts",
    "#veta/test": "./backend/src/test-support/test.ts",
    "#veta/fake-time": "./backend/src/test-support/fake-time.ts",
    "#veta/fs-walk": "./backend/src/test-support/fs-walk.ts",
    "#veta/test-server": "./backend/src/test-support/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "5.0.5",
    "c8": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0"
  }
}
