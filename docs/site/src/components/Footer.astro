---
import Default from "@astrojs/starlight/components/Footer.astro";
import { BUILD_INFO } from "../generated/build-info";

const buildDate = new Date(BUILD_INFO.buildDate);
const formattedDate = buildDate.toISOString().replace("T", " ").slice(0, 16) + " UTC";
const repoUrl = "https://github.com/milesburton/veta-trading-platform";
const commitUrl =
  BUILD_INFO.commitSha === "unknown"
    ? null
    : `${repoUrl}/commit/${BUILD_INFO.commitSha}`;
---

<Default><slot /></Default>

<div class="build-info" data-testid="build-info">
  <span>Docs built {formattedDate}</span>
  <span class="sep">·</span>
  <span>v{BUILD_INFO.version}</span>
  <span class="sep">·</span>
  {
    commitUrl ? (
      <a href={commitUrl} target="_blank" rel="noopener">
        {BUILD_INFO.commitSha}
      </a>
    ) : (
      <span>{BUILD_INFO.commitSha}</span>
    )
  }
</div>

<style>
  .build-info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 0.5rem auto 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono, ui-monospace, monospace);
  }
  .build-info a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }
  .build-info a:hover {
    color: var(--sl-color-white);
  }
  .build-info .sep {
    opacity: 0.5;
  }
</style>
