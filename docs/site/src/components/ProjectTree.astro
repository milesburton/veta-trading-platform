const groupColours: Record<string, string> = {
  backend: "#34d399",
  frontend: "#60a5fa",
  shared: "#fbbf24",
  service: "#34d399",
  tests: "#a78bfa",
  docs: "#fb923c",
  config: "#94a3b8",
};

function flatten(node: Node, depth: number, isLast: boolean[], inheritGroup?: string): { name: string; note?: string; group?: string; depth: number; isLast: boolean[]; isDir: boolean }[] {
  const group = node.group ?? inheritGroup;
  const out: { name: string; note?: string; group?: string; depth: number; isLast: boolean[]; isDir: boolean }[] = [
    { name: node.name, note: node.note, group, depth, isLast: [...isLast], isDir: node.kind === "dir" },
  ];
  if (node.kind === "dir") {
    for (let i = 0; i < node.children.length; i++) {
      const child = node.children[i];
      const last = i === node.children.length - 1;
      out.push(...flatten(child, depth + 1, [...isLast, last], group));
    }
  }
  return out;
}

const rows = flatten(tree, 0, []);

function prefix(isLast: boolean[]): string {
  if (isLast.length === 0) return "";
  let s = "";
  for (let i = 0; i < isLast.length - 1; i++) {
    s += isLast[i] ? "  " : "│ ";
  }
  s += isLast[isLast.length - 1] ? "└─" : "├─";
  return s;
}
---

<div class="project-tree">
  {rows.map((row) => (
    <div class={`row${row.isDir ? " is-dir" : ""}`}>
      <span class="prefix">{prefix(row.isLast)}</span>
      <span class="name" style={row.group ? `--group-color: ${groupColours[row.group]}` : ""}>{row.name}</span>
      {row.note && <span class="note">{row.note}</span>}
    </div>
  ))}
</div>

<div class="legend">
  {Object.entries(groupColours).filter(([k]) => k !== "service").map(([k, c]) => (
    <span class="legend-item">
      <span class="dot" style={`background: ${c}`}></span>
      {k}
    </span>
  ))}
</div>

<style>
  .project-tree {
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    line-height: 1.5;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0 0.75rem;
  }
  .row {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.05rem 0;
    white-space: nowrap;
  }
  .row.is-dir .name {
    font-weight: 600;
  }
  .prefix {
    color: var(--sl-color-gray-4);
    white-space: pre;
  }
  .name {
    color: var(--group-color, var(--sl-color-white));
  }
  .note {
    color: var(--sl-color-gray-3);
    font-size: 0.74rem;
    font-style: italic;
  }
  .note::before { content: "— "; }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    padding: 0 0.25rem;
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
  }
</style>
