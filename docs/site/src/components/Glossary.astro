---
import { CATEGORIES, TERMS, type GlossaryTerm } from "../data/glossary";

const termById = new Map<string, GlossaryTerm>(TERMS.map((t) => [t.id, t]));

const groups = CATEGORIES.map((cat) => ({
  ...cat,
  terms: TERMS.filter((t) => t.category === cat.id).sort((a, b) =>
    a.term.localeCompare(b.term),
  ),
})).filter((g) => g.terms.length > 0);

const total = TERMS.length;
const repoBase = "https://github.com/milesburton/veta-trading-platform/blob/main/";

const orphans = TERMS.flatMap((t) =>
  (t.seeAlso ?? []).filter((id) => !termById.has(id)).map((id) => `${t.id} → ${id}`),
);
if (orphans.length > 0) {
  throw new Error(
    `Glossary has dangling seeAlso references:\n  ${orphans.join("\n  ")}`,
  );
}
---

<div class="glossary">
  <div class="glossary-controls">
    <input
      type="search"
      class="glossary-search"
      placeholder={`Search ${total} terms…`}
      aria-label="Search the glossary"
      data-glossary-search
    />
    <div class="glossary-filters" role="tablist" aria-label="Glossary categories">
      <button type="button" class="glossary-filter is-active" data-filter="all">
        All <span class="count">{total}</span>
      </button>
      {groups.map((g) => (
        <button type="button" class="glossary-filter" data-filter={g.id}>
          {g.label} <span class="count">{g.terms.length}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="glossary-empty" data-glossary-empty hidden>
    No terms match. Try a different search or filter.
  </div>

  <div class="glossary-groups">
    {groups.map((group) => (
      <section class="glossary-group" data-category={group.id}>
        <header class="glossary-group-head">
          <h2 id={`category-${group.id}`}>{group.label}</h2>
          <p>{group.description}</p>
        </header>
        <dl class="glossary-list">
          {group.terms.map((t) => (
            <div
              class="glossary-entry"
              id={`term-${t.id}`}
              data-term={t.term.toLowerCase()}
              data-acronym={(t.acronymOf ?? "").toLowerCase()}
              data-short={t.short.toLowerCase()}
              data-long={(t.long ?? "").toLowerCase()}
              data-category={t.category}
            >
              <dt>
                <span class="term">{t.term}</span>
                {t.acronymOf && <span class="acronym">— {t.acronymOf}</span>}
              </dt>
              <dd>
                <p class="short">{t.short}</p>
                {t.long && <p class="long">{t.long}</p>}
                {(t.seeAlso?.length || t.source) && (
                  <p class="meta">
                    {t.seeAlso && t.seeAlso.length > 0 && (
                      <span class="see-also">
                        See also:
                        {t.seeAlso.map((ref, i) => {
                          const target = termById.get(ref);
                          if (!target) return null;
                          return (
                            <>
                              {i > 0 && ", "}
                              <a href={`#term-${target.id}`}>{target.term}</a>
                            </>
                          );
                        })}
                      </span>
                    )}
                    {t.source && (
                      <span class="source">
                        Source: <a href={`${repoBase}${t.source}`} target="_blank" rel="noopener">{t.source}</a>
                      </span>
                    )}
                  </p>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector(".glossary");
  if (root) {
    const search = root.querySelector("[data-glossary-search]") as HTMLInputElement | null;
    const empty = root.querySelector("[data-glossary-empty]") as HTMLElement | null;
    const filterButtons = root.querySelectorAll<HTMLButtonElement>(".glossary-filter");
    const groups = root.querySelectorAll<HTMLElement>(".glossary-group");
    const entries = root.querySelectorAll<HTMLElement>(".glossary-entry");

    let query = "";
    let category = "all";

    function apply() {
      const q = query.trim().toLowerCase();
      let matched = 0;
      entries.forEach((el) => {
        const text = [
          el.dataset.term ?? "",
          el.dataset.acronym ?? "",
          el.dataset.short ?? "",
          el.dataset.long ?? "",
        ].join(" ");
        const matchesText = q === "" || text.includes(q);
        const matchesCategory = category === "all" || el.dataset.category === category;
        const visible = matchesText && matchesCategory;
        el.hidden = !visible;
        if (visible) matched++;
      });
      groups.forEach((g) => {
        const anyVisible = g.querySelectorAll<HTMLElement>(".glossary-entry:not([hidden])").length > 0;
        g.hidden = !anyVisible;
      });
      if (empty) empty.hidden = matched > 0;
    }

    search?.addEventListener("input", () => {
      query = search.value;
      apply();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        category = btn.dataset.filter ?? "all";
        apply();
      });
    });
  }
</script>

<style>
  .glossary { margin: 1rem 0 0; }

  .glossary-controls {
    position: sticky;
    top: var(--sl-nav-height, 3.5rem);
    z-index: 5;
    background: var(--sl-color-bg);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .glossary-search {
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    color: var(--sl-color-white);
    font-size: 0.9rem;
  }
  .glossary-search:focus {
    outline: none;
    border-color: var(--sl-color-text-accent);
  }

  .glossary-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .glossary-filter {
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-2);
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .glossary-filter:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
  .glossary-filter.is-active {
    color: var(--sl-color-bg);
    background: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }
  .glossary-filter .count {
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
    margin-left: 0.25rem;
    font-size: 0.7rem;
  }

  .glossary-empty {
    padding: 1.5rem;
    border: 1px dashed var(--sl-color-gray-5);
    border-radius: 8px;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  .glossary-group {
    margin: 0 0 2rem;
  }
  .glossary-group-head h2 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
    color: var(--sl-color-white);
  }
  .glossary-group-head p {
    margin: 0 0 0.85rem;
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
  }

  .glossary-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .glossary-entry {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 1.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--sl-color-gray-6);
    align-items: baseline;
  }
  @media (max-width: 50rem) {
    .glossary-entry {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  .glossary-entry dt {
    margin: 0;
  }
  .glossary-entry .term {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .glossary-entry .acronym {
    display: block;
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.1rem;
  }
  .glossary-entry dd {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .glossary-entry .short {
    margin: 0;
  }
  .glossary-entry .long {
    margin: 0.5rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
  }
  .glossary-entry .meta {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
  }
  .glossary-entry .meta a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .glossary-entry .meta a:hover {
    text-decoration: underline;
  }
  .glossary-entry:target {
    background: var(--sl-color-bg-sidebar);
    border-left: 3px solid var(--sl-color-text-accent);
    padding-left: 0.5rem;
    margin-left: -0.5rem;
  }
</style>
