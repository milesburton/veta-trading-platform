---
import Default from "@astrojs/starlight/components/Header.astro";
import { BUILD_INFO } from "../generated/build-info";

const repoUrl = "https://github.com/milesburton/veta-trading-platform";
const platformUrl = "https://veta.mnetcs.com/";
const commitUrl =
  BUILD_INFO.commitSha === "unknown"
    ? null
    : `${repoUrl}/commit/${BUILD_INFO.commitSha}`;
const tooltip = `Docs built ${
  new Date(BUILD_INFO.buildDate).toISOString().replace("T", " ").slice(0, 16)
} UTC · ${BUILD_INFO.commitSha}`;
---

<Default><slot /></Default>

<div class="veta-header-actions">
  <a
    class="veta-build-chip"
    data-testid="build-info"
    href={commitUrl ?? repoUrl}
    target="_blank"
    rel="noopener"
    title={tooltip}
  >
    <span class="veta-env">DOCS</span>
    <span class="veta-version">v{BUILD_INFO.version}</span>
    <span class="veta-sep">·</span>
    <span class="veta-sha">{BUILD_INFO.commitSha}</span>
  </a>

  <a
    class="veta-platform-cta"
    data-testid="platform-cta"
    href={platformUrl}
    target="_blank"
    rel="noopener"
    title="Open the live VETA trading platform"
  >
    <span class="veta-platform-cta-label">Open platform</span>
    <svg
      class="veta-platform-cta-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </a>
</div>

<style>
  .veta-header-actions {
    display: none;
    position: absolute;
    top: 50%;
    right: calc(var(--sl-nav-pad-x) + 9rem);
    transform: translateY(-50%);
    align-items: center;
    gap: 0.75rem;
    z-index: 1;
  }
  @media (min-width: 60rem) {
    .veta-header-actions {
      display: inline-flex;
    }
  }
  .veta-platform-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    border-radius: 4px;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.15s, transform 0.15s;
  }
  .veta-platform-cta:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .veta-platform-cta:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }
  .veta-platform-cta-icon {
    flex-shrink: 0;
  }
  .veta-build-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 4px;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .veta-build-chip:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
  .veta-env {
    color: var(--sl-color-text-accent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .veta-version {
    font-weight: 600;
  }
  .veta-sep {
    opacity: 0.5;
  }
  .veta-sha {
    opacity: 0.8;
  }
</style>
