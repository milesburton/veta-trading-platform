#!/bin/sh

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
COMMIT_SHA=$(git rev-parse --short HEAD)

if [ -f "$REPO_ROOT/.env" ]; then
  if grep -q "^COMMIT_SHA=" "$REPO_ROOT/.env"; then
    sed -i "s/^COMMIT_SHA=.*/COMMIT_SHA=$COMMIT_SHA/" "$REPO_ROOT/.env"
  else
    echo "COMMIT_SHA=$COMMIT_SHA" >> "$REPO_ROOT/.env"
  fi
fi

echo "Pre-commit checks... (commit: $COMMIT_SHA)"

echo "  [0/12] Verifying clean working directory..."
# Block unstaged changes to tracked files. Staged changes are expected —
# those are what we're about to commit. Using `git diff-index HEAD` here
# would also flag the staged files and make any normal commit fail.
if ! git diff --quiet; then
  echo "❌ ERROR: You have unstaged changes to tracked files."
  echo "Please stage or stash them before committing:"
  git diff --name-only
  exit 1
fi

echo "  [1/12] Backend lint..."
cd "$REPO_ROOT"
deno task lint

echo "  [2/12] Backend type-check..."
deno task check

echo "  [3/12] Backend unit tests..."
deno task test

echo "  [4/12] Frontend lint (all files)..."
cd "$REPO_ROOT/frontend"
deno run -A npm:@biomejs/biome check src/

echo "  [5/12] Frontend type-check (all files)..."
./node_modules/.bin/tsc --noEmit --skipLibCheck

echo "  [6/12] Frontend unit tests..."
./node_modules/.bin/vitest run

echo "  [7/12] Integration tests (skipped if services offline)..."
cd "$REPO_ROOT"
if curl -sf http://localhost:5000/health >/dev/null 2>&1 && curl -sf http://localhost:5032/health >/dev/null 2>&1; then
  deno task test:integration
else
  echo "       Services not fully running — skipping integration tests."
fi

echo "  [8/12] Prometheus alert rules..."
cd "$REPO_ROOT"
if git diff --cached --name-only | grep -qE '^observability/(prometheus-rules\.ya?ml|prometheus-rules\.test\.ya?ml)$'; then
  if command -v promtool >/dev/null 2>&1; then
    promtool check rules observability/prometheus-rules.yml
    promtool test rules observability/prometheus-rules.test.yml
  else
    echo "       promtool not on PATH — skipping (CI runs the hard gate)."
    echo "       To install locally: see docs/site/src/content/docs/platform/observability/alerts.mdx"
  fi
else
  echo "       No staged changes to alert rules — skipping."
fi

echo "  [9/12] Docs drift check (regenerate derived files)..."
# `npm run generate` rebuilds rbac-roles.json, panel-matrix.json,
# services.md, algos.md, tech-stack.mdx, migrations.md, etc. from
# the live source. If anything drifts, the gate blocks the commit
# and tells you what to do. Skipped when docs/site deps aren't
# installed (fresh clone before `cd docs/site && npm ci`).
if [ -d "$REPO_ROOT/docs/site/node_modules" ]; then
  (cd "$REPO_ROOT/docs/site" && npm run generate >/dev/null 2>&1)
  cd "$REPO_ROOT"
  if ! git diff --quiet -- docs/site/; then
    echo "❌ ERROR: Generated docs files are out of sync with source code."
    echo "The following files would change after running 'npm run generate':"
    git diff --name-only -- docs/site/
    echo ""
    echo "Stage and amend / re-commit:"
    echo "  git add docs/site"
    echo "  # then re-run your git commit command"
    exit 1
  fi
else
  echo "       docs/site/node_modules missing — skipping (run 'cd docs/site && npm ci')."
fi

echo "  [10/12] Private IPs in public docs..."
# The Astro/Starlight site under docs/site/src/ is published to GitHub Pages,
# so it is internet-public. Reject RFC1918 (10/8, 172.16/12, 192.168/16)
# addresses in source files, which would advertise internal infrastructure.
# Loopback (127/8) is excluded — it is a generic "this machine" address and
# leaks nothing. Mirrors the hard gate in the frontend CI workflow.
cd "$REPO_ROOT"
if grep -rnE '\b(10\.[0-9]+\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+)\b' \
    docs/site/src/ \
    --include='*.md' --include='*.mdx' --include='*.html' --include='*.tsx' --include='*.ts'; then
  echo "❌ ERROR: Private IP address(es) leaked into public docs (docs/site/src/)."
  echo "Remove them or describe the range abstractly (e.g. RFC 5737 doc ranges"
  echo "203.0.113.0/24, 198.51.100.0/24)."
  exit 1
fi

echo "  [11/12] Docs build (link check + content validity)..."
# `astro build` runs the Starlight link checker, which catches broken relative
# links (e.g. ./services resolving under the wrong path segment) that no other
# gate sees. Mirrors the hard gate in the Docs build & lint CI job.
if [ -d "$REPO_ROOT/docs/site/node_modules" ]; then
  (cd "$REPO_ROOT/docs/site" && npm run build >/dev/null 2>&1) || {
    echo "❌ ERROR: Docs build failed (broken links or invalid content)."
    echo "Reproduce locally: (cd docs/site && npm run build)"
    exit 1
  }
  cd "$REPO_ROOT"
else
  echo "       ⚠️  docs/site/node_modules missing — SKIPPING docs build gate."
  echo "       CI will run the hard gate. Install with: cd docs/site && npm ci"
fi

echo "  [12/12] Fallow audit (staged vs HEAD; advisory)..."
# `fallow audit` reports new findings introduced by the changeset.
# Run as advisory rather than blocking: fallow's introduced/inherited
# attribution flags line-shifted clones from sibling PRs as "new" even
# when the code is identical to main. CI runs the strict version, this
# is a fast local heads-up. The signal goes to stdout regardless.
# Skipped when fallow isn't installed (e.g. fresh clone before npm ci).
cd "$REPO_ROOT/frontend"
if [ -x "./node_modules/.bin/fallow" ]; then
  ./node_modules/.bin/fallow audit --root "$REPO_ROOT" --changed-since HEAD || \
    echo "       fallow audit flagged findings (advisory; see CI for the hard gate)."
else
  echo "       fallow not installed in frontend/node_modules — skipping (run npm ci)."
fi

echo "Pre-commit checks passed."
