{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "terminal.integrated.defaultProfile.linux": "fish",
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": true,
    "markdown": true,
    "fish": true,
    "shell": true
  },
  "github.copilot.advanced": {
    "debug.overrideChatModel": "gpt-4"
  },
  "codeium.enableConfig": {
    "*": true
  },
  "codeium.chat": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "cline.preferredLanguage": "English",
  "cline.enableCheckpoints": true,
  "cline.mcpMarketplace.enabled": true,
  "roo-cline.preferredLanguage": "English",
  "roo-cline.allowedCommands": ["npm test", "npm run", "node", "git log", "git diff", "git status"]
}
