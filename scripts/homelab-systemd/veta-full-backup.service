[Unit]
Description=VETA full platform backup (databases, vault, config, volumes), age-encrypted
Documentation=https://github.com/milesburton/veta-trading-platform/blob/main/scripts/full-backup.sh
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=miles
WorkingDirectory=/opt/stacks/veta
ExecStart=/opt/stacks/veta/scripts/full-backup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60min
