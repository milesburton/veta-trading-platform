{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/product-service", "src/lib/http.ts", "src/lib/logger.ts", "src/lib/messaging.ts", "src/lib/telemetry.ts", "src/lib/bootstrap.ts"]
}
